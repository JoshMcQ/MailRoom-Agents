{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@mailroom/core": ["packages/core/src"],
      "@mailroom/connectors": ["packages/connectors/src"],
      "@mailroom/llm": ["packages/llm/src"],
      "@mailroom/ui": ["packages/ui/src"],
      "@mailroom/types": ["packages/types/src"],
      "@mailroom/types/*": ["packages/types/src/*"]
    }
  }
}
